generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdInteractions Interaction[] @relation("InteractionCreatedBy")
  editedInteractions  Interaction[] @relation("InteractionEditedBy")
  stageChanges StageChange[]
  callProfile  UserCallProfile?

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Companies
// ─────────────────────────────────────────────────────────────

enum CompanyType {
  PARTNER
  ISV
  END_USER
}

enum RelationshipStatus {
  PROSPECT
  ACTIVE_CLIENT
  DORMANT
  DO_NOT_CONTACT
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  website            String?
  linkedinUrl        String?
  industry           String?
  companyType        CompanyType?
  size               String?
  hqLocation         String?
  addressStreet      String?
  addressCity        String?
  addressPostcode    String?
  relationshipStatus RelationshipStatus @default(PROSPECT)
  notes              String?

  // Archive (soft-delete): hidden from default views but never hard-deleted —
  // companies anchor jobs/interactions/documents history.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     Person[]      @relation("PersonClientCompany")
  employeesAt  Person[]      @relation("PersonCurrentEmployer")
  jobs         Job[]
  documents    Document[]
  interactions Interaction[]
  tags         TagLink[]
  placements   Placement[]
  candidateProspects CandidateProspect[]
  opportunities Opportunity[]

  terms CompanyTerms?

  // Set true the moment an Opportunity's Won transition first converts this
  // company to Active Client with no Terms yet on file — cleared the moment
  // Terms are actually saved (see CompanyTerms below). Surfaced as a nudge on
  // the Company page and the Dashboard activity feed so onboarding a new
  // client's Terms doesn't get forgotten.
  needsTermsSetup Boolean @default(false)

  @@map("companies")
}

// Commercial terms agreed with an Active Client — fee %, payment terms,
// invoicing contact, special arrangements, plus the Terms of Business
// document itself (via the existing Documents feature). One company has at
// most one Terms record; it doesn't exist at all until first filled in,
// which is what lets `Company.needsTermsSetup` distinguish "never set up"
// from "deliberately left blank."
model CompanyTerms {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  // The standard fee %, used to default the Fee % on future Placements for
  // this company (still editable per-placement for one-off exceptions).
  feeStructurePercentage Decimal? @db.Decimal(5, 2)
  feeExceptions          String?

  paymentTerms String?

  // The Client Contact who should receive invoices — not always someone
  // already in the system, so the UI supports creating a brand-new Client
  // Contact on the fly via the single PersonCreateForm, same as everywhere
  // else a Client Contact is created.
  invoicingContactId String?
  invoicingContact   Person? @relation("CompanyTermsInvoicingContact", fields: [invoicingContactId], references: [id])

  specialTerms String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_terms")
}

// ─────────────────────────────────────────────────────────────
// BD Opportunities — active new-business pursuits, distinct from a
// Company's relationshipStatus (a passive flag). A company can have several
// Opportunities over time (won one, later pursuing a second department) and
// can hold an open Opportunity while already an Active Client elsewhere.
// ─────────────────────────────────────────────────────────────

enum OpportunityStage {
  IDENTIFIED
  RESEARCHED
  CONTACTED
  MEETING_BOOKED
  PROPOSAL_SENT
  WON
  LOST
}

model Opportunity {
  id        String   @id @default(uuid())
  // Both nullable: a new Opportunity starts "lightweight" — just a
  // plain-text company name (prospectCompanyName), no Company record yet.
  // companyId is set once the Opportunity converts (see below), and from
  // then on company.name is the source of truth; prospectCompanyName is
  // kept only as a historical record of what was originally typed.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  prospectCompanyName String?

  title String
  notes String?

  stage OpportunityStage @default(IDENTIFIED)

  // Required when stage = LOST (free text or a short tag like "Price" /
  // "Timing" / "Chose competitor" / "Other") — cleared if the opportunity is
  // later moved off Lost, since a stale reason would be misleading if it's
  // revisited. There is deliberately no archive flag: a Lost opportunity
  // stays visible and searchable in case it's worth pursuing again later.
  lostReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledEvents ScheduledEvent[]
  targetContacts  TargetContact[]

  @@map("opportunities")
  @@index([companyId])
  @@index([stage])
}

// A lightweight prospecting contact attached to an Opportunity before a real
// Client Contact exists — fast to add (name, plus optional job title/email/
// phone/LinkedIn, none forced), and interactions can be logged against one
// exactly as against a real Person (see Interaction.targetContactId).
// Converted into a real Person (personType CLIENT_CONTACT) automatically
// once the Opportunity reaches Meeting Booked; convertedPersonId marks that
// this has happened and prevents re-conversion. A Target Contact that's
// never converted (e.g. one of several who didn't reply) simply stays part
// of the Opportunity's history — nothing forces it to become a full record.
model TargetContact {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  name        String
  jobTitle    String?
  email       String?
  phone       String?
  linkedinUrl String?

  convertedPersonId String? @unique
  convertedPerson   Person? @relation("TargetContactConverted", fields: [convertedPersonId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interactions Interaction[]

  @@map("target_contacts")
  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────────
// People (Candidates & Client Contacts)
// ─────────────────────────────────────────────────────────────

enum PersonType {
  CANDIDATE
  CLIENT_CONTACT
}

enum WorkPreference {
  REMOTE
  HYBRID
  ONSITE
}

enum DecisionRole {
  HIRING_MANAGER
  PRACTICE_LEAD
  DELIVERY_DIRECTOR
  HR
  OTHER
}

enum PersonSource {
  LINKEDIN
  REFERRAL
  INBOUND
  SOURCED
  OTHER
}

model Person {
  id         String     @id @default(uuid())
  personType PersonType

  firstName   String
  surname     String?
  workEmail     String?
  personalEmail String?
  phone       String?
  linkedinUrl String?
  addressStreet   String?
  addressCity     String?
  addressPostcode String?

  // Candidate-specific fields
  currentEmployerId    String?
  currentEmployer      Company? @relation("PersonCurrentEmployer", fields: [currentEmployerId], references: [id])
  currentTitle         String?
  seniority            String?
  dayRate              Decimal? @db.Decimal(10, 2)
  salaryExpectation    Decimal? @db.Decimal(10, 2)
  location             String?
  workPreference       WorkPreference?
  rightToWork          String?
  availability         String?
  motivationsText      String?

  // Client-contact-specific fields
  companyId       String?
  company         Company?      @relation("PersonClientCompany", fields: [companyId], references: [id], onDelete: SetNull)
  jobTitle        String?
  decisionRole    DecisionRole?
  relationshipNotes String?

  // Shared
  source            PersonSource?
  gdprConsent       Boolean       @default(false)
  gdprConsentNote   String?
  lawfulBasisNote   String?
  retentionReviewAt DateTime?

  // Follow-up reminder: settable at any time, or alongside an interaction log.
  followUpAt   DateTime?
  followUpNote String?

  // Soft delete / anonymize (GDPR) — permanently scrubs personal fields
  isAnonymized Boolean   @default(false)
  deletedAt    DateTime?

  // Archive: hidden from default views but fully reversible, unlike anonymize.
  archivedAt DateTime?

  // Linked-record feature: a candidate and a client-contact record can represent
  // the same human being over time. This self-relation lets us flip which side
  // is "primary" without losing history on either record.
  // @unique enforces "at most one link at a time" on the target side — a
  // given person can only ever be pointed at by one other record. The
  // owning side is naturally capped at one link since linkedPersonId is a
  // single scalar field, not a list.
  linkedPersonId String?  @unique
  linkedPerson   Person?  @relation("PersonLink", fields: [linkedPersonId], references: [id])
  linkedFrom     Person[] @relation("PersonLink")
  isPrimaryLink  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills            PersonSkill[]
  roleTypes         RoleType[]    @relation("PersonRoleTypes")
  documents         Document[]
  interactions      Interaction[]
  jobApplications   JobCandidate[]
  ownedJobs         Job[]         @relation("JobOwningContact")
  placements        Placement[]   @relation("PlacementCandidate")
  tags              TagLink[]
  prospectEntries   CandidateProspect[] @relation("ProspectCandidate")
  // BD meetings this Client Contact is the meeting's contact for — distinct
  // from jobApplications, which is the candidate-side pipeline relation.
  meetingsAsContact ScheduledEvent[] @relation("ScheduledEventContact")
  // Set if this Person was auto-created by converting a lightweight
  // Target Contact (see TargetContact.convertedPersonId).
  targetContactOrigin TargetContact? @relation("TargetContactConverted")
  // Companies whose invoicing contact this Client Contact is (see
  // CompanyTerms.invoicingContactId).
  invoicingForTerms CompanyTerms[] @relation("CompanyTermsInvoicingContact")

  @@map("people")
  @@index([personType])
  @@index([companyId])
  @@index([currentEmployerId])
}

// A hierarchical tag tree (any depth), shared by Person and Job skill
// assignment — not a fixed set of hardcoded categories. Grows as skills are
// added via the picker; parentId is null for a top-level branch.
//
// Uniqueness is scoped to (parentId, name), not name alone — the same leaf
// name can legitimately appear under two different branches (e.g. "Finance"
// under both D365 F&O and Business Central), and each is a distinct node.
model Skill {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  parent   Skill?  @relation("SkillHierarchy", fields: [parentId], references: [id])
  children Skill[] @relation("SkillHierarchy")

  people PersonSkill[]
  jobsEssential Job[] @relation("JobEssentialSkills")
  jobsIdeal     Job[] @relation("JobIdealSkills")

  @@unique([parentId, name], name: "parentId_name")
  @@map("skills")
  @@index([parentId])
}

// Flat (non-hierarchical) tag list of professional role types — e.g.
// "Functional Consultant", "Solution Architect" — distinct from the Skill
// tree. A Candidate can hold several at once; a Job lists whichever the
// role requires. Grows via the same "add new on the fly" idiom as Skill.
model RoleType {
  id   String @id @default(uuid())
  name String @unique

  people Person[] @relation("PersonRoleTypes")
  jobs   Job[]    @relation("JobRoleTypes")

  @@map("role_types")
}

model PersonSkill {
  id       String @id @default(uuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // A candidate's real specialisms vs. everything else they're merely
  // competent in — a flag on the assignment itself, not a separate list.
  isPrimary Boolean @default(false)

  @@unique([personId, skillId])
  @@map("person_skills")
}

// ─────────────────────────────────────────────────────────────
// Jobs & Pipeline
// ─────────────────────────────────────────────────────────────

enum JobStage {
  POTENTIAL_LEAD
  QUALIFIED
  SPEC_TAKEN
  CV_SOURCING
  CVS_SENT
  INTERVIEWING
  OFFERED
  PLACED
  REJECTED
}

// The recruiter's own judgement of how likely this job is to close and how
// good the information on it is — never calculated, always manually set.
// Required at creation so nothing ends up unrated by accident.
enum JobQualityRating {
  A
  B
  C
}

model Job {
  id       String @id @default(uuid())
  title    String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  level          String?
  location       String?
  workPreference WorkPreference?

  salaryMin Decimal? @db.Decimal(10, 2)
  salaryMax Decimal? @db.Decimal(10, 2)
  rateMin   Decimal? @db.Decimal(10, 2)
  rateMax   Decimal? @db.Decimal(10, 2)

  stage JobStage @default(POTENTIAL_LEAD)

  qualityRating JobQualityRating

  // Free-text alternative/complement to an uploaded Job Spec document — some
  // clients just email the details rather than sending a formal doc. No
  // version history: a single field that's overwritten on edit.
  jobSpecText String?

  // Archive (soft-delete): hidden from default views but never hard-deleted —
  // jobs anchor pipeline/placement/interaction history.
  archivedAt DateTime?

  owningContactId String?
  owningContact   Person? @relation("JobOwningContact", fields: [owningContactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  essentialSkills Skill[]   @relation("JobEssentialSkills")
  idealSkills     Skill[]   @relation("JobIdealSkills")
  roleTypes       RoleType[] @relation("JobRoleTypes")

  candidates   JobCandidate[]
  documents    Document[]
  interactions Interaction[]
  stageChanges StageChange[]
  placement    Placement?
  tags         TagLink[]
  candidateProspects CandidateProspect[]

  @@map("jobs")
  @@index([companyId])
  @@index([stage])
  @@index([qualityRating])
}

enum CandidateStage {
  SHORTLISTED
  CV_SENT
  REJECTED
  FIRST_INTERVIEW
  FURTHER_INTERVIEWS
  OFFERED
  PLACED
}

model JobCandidate {
  id          String         @id @default(uuid())
  jobId       String
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Person         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       CandidateStage @default(SHORTLISTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageChanges    StageChange[]
  scheduledEvents ScheduledEvent[]

  @@unique([jobId, candidateId])
  @@map("job_candidates")
  @@index([stage])
}

enum ScheduledEventFormat {
  PHONE
  VIDEO
  FACE_TO_FACE
}

// Shared scheduling structure for both candidate interviews and BD
// Opportunity meetings — exactly one of jobCandidateId/opportunityId is set
// per row, so both features are stored and displayed identically and share
// one API/UI (see ScheduledEventsPanel.tsx). Any future scheduled-event type
// should extend this model rather than introducing a separate one.
// Multiple rows per parent are expected (further interview rounds, several
// BD meetings) — numbered by scheduledAt order at display time rather than
// stored, so there's no "round number" to keep in sync. scheduledAt is a
// real DateTime (not free text) so this is ready to sync outward to an
// actual calendar (Outlook/Google) later without a data migration.
model ScheduledEvent {
  id             String        @id @default(uuid())
  jobCandidateId String?
  jobCandidate   JobCandidate? @relation(fields: [jobCandidateId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  // Which Client Contact a BD meeting is with — required for an
  // opportunity meeting, always null for a candidate interview.
  contactId String?
  contact   Person? @relation("ScheduledEventContact", fields: [contactId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  format      ScheduledEventFormat
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("scheduled_events")
  @@index([jobCandidateId])
  @@index([opportunityId])
  @@index([contactId])
  @@index([scheduledAt])
}

// Append-only log of every stage transition, at job level or job-candidate level.
model StageChange {
  id             String   @id @default(uuid())
  jobId          String?
  job            Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobCandidateId String?
  jobCandidate   JobCandidate? @relation(fields: [jobCandidateId], references: [id], onDelete: Cascade)

  fromStage String?
  toStage   String
  changedById String?
  changedBy   User?  @relation(fields: [changedById], references: [id])
  note        String?

  createdAt DateTime @default(now())

  @@map("stage_changes")
  @@index([jobId])
  @@index([jobCandidateId])
}

// Preserves shortlisting history once a Job closes (Placed or Lost/Rejected)
// so it isn't buried inside a closed job — one row per candidate who reached
// Shortlisted-or-beyond on that job but wasn't the eventual placement.
// Surfaced as "previously shortlisted, may fit" suggestions on future jobs
// with matching skills/seniority/location.
model CandidateProspect {
  id          String   @id @default(uuid())
  candidateId String
  candidate   Person   @relation("ProspectCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  sourceJobId String
  sourceJob   Job      @relation(fields: [sourceJobId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  // The furthest stage they reached on that job before it closed.
  reachedStage CandidateStage

  createdAt DateTime @default(now())

  @@unique([candidateId, sourceJobId])
  @@map("candidate_prospects")
  @@index([candidateId])
}

// ─────────────────────────────────────────────────────────────
// Documents (versioned)
// ─────────────────────────────────────────────────────────────

enum DocumentType {
  CANDIDATE_CV
  CRUX_FORMATTED_CV
  TERMS_OF_BUSINESS
  COMPANY_DOC
  JOB_SPEC
  CONTRACTOR_CORP_DOC
  OTHER
}

model Document {
  id   String       @id @default(uuid())
  type DocumentType

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Compliance/expiry tracking (e.g. contractor insurance)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  versions DocumentVersion[]

  @@map("documents")
  @@index([personId])
  @@index([companyId])
  @@index([jobId])
}

// Every re-upload creates a new immutable version; nothing is overwritten.
model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNo   Int
  fileName    String
  storageKey  String
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime @default(now())
  note        String?

  // Plain text pulled from the file at upload time (CV document types only —
  // see documents.ts) so every CV version, not just the current one, is
  // full-text searchable. Left null for non-CV document types and for any
  // file text extraction couldn't handle.
  extractedText String? @db.Text
  // Generated/indexed by the migration's raw SQL (STORED, from
  // extractedText) — Prisma can't express a generated column, so it's
  // marked Unsupported here purely so introspection/diffing leaves it alone;
  // query it via $queryRaw.
  searchVector Unsupported("tsvector")?

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

// ─────────────────────────────────────────────────────────────
// Interactions (append-only)
// ─────────────────────────────────────────────────────────────

enum InteractionType {
  PHONE_CALL
  VIDEO_MEETING
  FACE_TO_FACE
  QUALIFICATION_CALL
  LINKEDIN_MESSAGE
  EMAIL
  TEXT
  VOICEMAIL
}

model Interaction {
  id     String           @id @default(uuid())
  type   InteractionType
  notes  String?
  occurredAt DateTime     @default(now())

  // Exactly one of personId/targetContactId is set — a real Person (the
  // established path) or a lightweight BD Target Contact, logged and
  // displayed the same way either way (see CLAUDE.md). Both optional so a
  // single model covers both; enforced at the API layer, same pattern as
  // ScheduledEvent's jobCandidateId/opportunityId split.
  personId String?
  person   Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  targetContactId String?
  targetContact   TargetContact? @relation(fields: [targetContactId], references: [id], onDelete: Cascade)
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("InteractionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Set the first time this interaction is edited after creation (see
  // PATCH /:id) — history stays append-only in spirit (nothing is silently
  // rewritten without a trace); the UI shows an "(edited)" marker whenever
  // editedAt is present rather than keeping full version history.
  editedAt   DateTime?
  editedById String?
  editedBy   User?     @relation("InteractionEditedBy", fields: [editedById], references: [id])

  // Optional Teams call transcript, pasted or uploaded alongside the note —
  // when present, a call reflection is based on what was actually said, not
  // just what got written down.
  transcript String? @db.Text

  // The 7-section Qualification Call template (Present/Past/Future/AOB/
  // Threats/Leads/Personal info), stored as its own field per section — only
  // ever populated for type QUALIFICATION_CALL, NULL for every other type
  // and for QUALIFICATION_CALL rows logged before this existed. `notes`
  // stays a server-computed concatenation of these 7 fields (same
  // labeled-header format as before) purely so every existing consumer of
  // notes — full-text search, Extract Intelligence, Reflect on Call, the
  // plain interaction-history render — keeps working unchanged; nothing
  // reads these 7 columns directly yet outside the extraction-review flow.
  qcPresent      String? @db.Text
  qcPast         String? @db.Text
  qcFuture       String? @db.Text
  qcAob          String? @db.Text
  qcThreats      String? @db.Text
  qcLeads        String? @db.Text
  qcPersonalInfo String? @db.Text

  // Generated/indexed by the migration's raw SQL (STORED, from notes —
  // which already contains every Qualification Call section, concatenated
  // with labeled headers, since that's how notes gets built for that type).
  // See DocumentVersion.searchVector for why this is Unsupported here.
  searchVector Unsupported("tsvector")?

  intelligence InteractionIntelligence?
  reflection   CallReflection?

  @@map("interactions")
  @@index([personId])
  @@index([targetContactId])
  @@index([jobId])
  @@index([companyId])
}

// AI-extracted intelligence from an interaction's notes — a derived artifact,
// not part of the append-only human-authored history, so re-running Extract
// Intelligence upserts (replaces) this rather than adding another row.
model InteractionIntelligence {
  id            String      @id @default(uuid())
  interactionId String      @unique
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  peopleMentioned    Json
  companiesMentioned Json
  marketSignals      Json
  followUpActions    Json
  notableQuotes      Json
  // Market signals specifically shaped like a new-business opportunity for
  // Crux Talent (e.g. "unhappy with current supplier", "expanding a team") —
  // reviewed in the same nothing-auto-created, approve-or-dismiss screen as
  // the rest of this extraction. Each item: { companyName, signal }.
  suggestedOpportunities Json

  // Candidate skills mentioned in the call notes that aren't tagged on the
  // Person yet, found with the same fuzzy/synonym matching used for CV
  // parsing (cvExtraction.ts's guessSkills), not the LLM. Empty/absent for
  // interactions with no linked Candidate (Client Contacts have no skills
  // to suggest). Each item: { id, name } — a real Skill row, so approving
  // one is a direct PUT to /api/people/:id/skills, same as everywhere else
  // a candidate's skills are set. Never auto-saved without approval.
  suggestedSkills Json?

  model     String
  createdAt DateTime @default(now())

  @@map("interaction_intelligence")
}

enum ReflectionBasis {
  TRANSCRIPT
  NOTE_ONLY
}

enum FeedbackReaction {
  UP
  DOWN
}

// A private, constructive critique of a Qualification Call — never a score.
// One per interaction (re-running replaces it, same derived-artifact idiom
// as InteractionIntelligence); `content` holds the structured reflection
// (thin sections, cross-section signals, the five core commercial
// questions, and a short closing summary).
model CallReflection {
  id            String      @id @default(uuid())
  interactionId String      @unique
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  basis   ReflectionBasis
  content Json
  model   String

  createdAt DateTime @default(now())

  feedback CallReflectionFeedback?

  @@map("call_reflections")
}

// The user's reaction to one reflection — the raw signal a rolling personal
// profile gets summarised from.
model CallReflectionFeedback {
  id           String         @id @default(uuid())
  reflectionId String         @unique
  reflection   CallReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)

  reaction FeedbackReaction
  comment  String?

  createdAt DateTime @default(now())

  @@map("call_reflection_feedback")
}

// A single rolling summary per user of the patterns in their call-review
// feedback — what tends to get missed, what's already done well, and what
// kinds of feedback they've dismissed as not useful. Regenerated (not
// appended) each time enough new feedback has accumulated, and fed as
// context into every future reflection so suggestions get more tailored
// over time instead of repeating the same generic notes.
model UserCallProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  summary String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_call_profiles")
}

// ─────────────────────────────────────────────────────────────
// Placements & Fees
// ─────────────────────────────────────────────────────────────

enum FeeType {
  PERM_PERCENTAGE
  CONTRACT_MARGIN
  DAY_RATE_UPLIFT
}

enum InvoiceStatus {
  NOT_INVOICED
  INVOICED
  PAID
  OVERDUE
  CANCELLED
}

model Placement {
  id          String   @id @default(uuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  candidateId String
  candidate   Person   @relation("PlacementCandidate", fields: [candidateId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  feeType     FeeType
  feeValue    Decimal  @db.Decimal(12, 2)
  invoiceStatus InvoiceStatus @default(NOT_INVOICED)
  invoiceRaisedDate DateTime?
  invoiceDueDate    DateTime?
  paidDate          DateTime?

  startDate DateTime
  endDate   DateTime?
  renewalReviewAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("placements")
}

// ─────────────────────────────────────────────────────────────
// Polymorphic tags / custom fields (extensibility without migrations)
// ─────────────────────────────────────────────────────────────

enum TaggableType {
  PERSON
  COMPANY
  JOB
  DOCUMENT
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String?

  links TagLink[]

  @@map("tags")
}

model TagLink {
  id            String       @id @default(uuid())
  tagId         String
  tag           Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  taggableType  TaggableType
  taggableId    String

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tagId, taggableType, taggableId])
  @@map("tag_links")
  @@index([taggableType, taggableId])
}

// Polymorphic custom fields: add new attributes to any entity without a migration.
model CustomField {
  id           String       @id @default(uuid())
  taggableType TaggableType
  taggableId   String
  key          String
  value        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taggableType, taggableId, key])
  @@map("custom_fields")
  @@index([taggableType, taggableId])
}
