generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  interactions Interaction[]
  stageChanges StageChange[]
  callProfile  UserCallProfile?

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Companies
// ─────────────────────────────────────────────────────────────

enum CompanyType {
  PARTNER
  ISV
  CONSULTANCY
  END_USER
}

enum RelationshipStatus {
  PROSPECT
  ACTIVE_CLIENT
  DORMANT
  DO_NOT_CONTACT
}

model Company {
  id                 String             @id @default(uuid())
  name               String
  website            String?
  linkedinUrl        String?
  industry           String?
  companyType        CompanyType?
  size               String?
  hqLocation         String?
  addressStreet      String?
  addressCity        String?
  addressPostcode    String?
  relationshipStatus RelationshipStatus @default(PROSPECT)
  notes              String?

  // Archive (soft-delete): hidden from default views but never hard-deleted —
  // companies anchor jobs/interactions/documents history.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts     Person[]      @relation("PersonClientCompany")
  employeesAt  Person[]      @relation("PersonCurrentEmployer")
  jobs         Job[]
  documents    Document[]
  interactions Interaction[]
  tags         TagLink[]
  placements   Placement[]

  @@map("companies")
}

// ─────────────────────────────────────────────────────────────
// People (Candidates & Client Contacts)
// ─────────────────────────────────────────────────────────────

enum PersonType {
  CANDIDATE
  CLIENT_CONTACT
}

enum WorkPreference {
  REMOTE
  HYBRID
  ONSITE
}

enum DecisionRole {
  HIRING_MANAGER
  PRACTICE_LEAD
  DELIVERY_DIRECTOR
  HR
  OTHER
}

enum PersonSource {
  LINKEDIN
  REFERRAL
  INBOUND
  SOURCED
  OTHER
}

model Person {
  id         String     @id @default(uuid())
  personType PersonType

  firstName   String
  surname     String?
  workEmail     String?
  personalEmail String?
  phone       String?
  linkedinUrl String?
  addressStreet   String?
  addressCity     String?
  addressPostcode String?

  // Candidate-specific fields
  currentEmployerId    String?
  currentEmployer      Company? @relation("PersonCurrentEmployer", fields: [currentEmployerId], references: [id])
  currentTitle         String?
  seniority            String?
  dayRate              Decimal? @db.Decimal(10, 2)
  salaryExpectation    Decimal? @db.Decimal(10, 2)
  location             String?
  workPreference       WorkPreference?
  rightToWork          String?
  availability         String?
  motivationsText      String?

  // Client-contact-specific fields
  companyId       String?
  company         Company?      @relation("PersonClientCompany", fields: [companyId], references: [id], onDelete: SetNull)
  jobTitle        String?
  decisionRole    DecisionRole?
  relationshipNotes String?

  // Shared
  source            PersonSource?
  gdprConsent       Boolean       @default(false)
  gdprConsentNote   String?
  lawfulBasisNote   String?
  retentionReviewAt DateTime?

  // Follow-up reminder: settable at any time, or alongside an interaction log.
  followUpAt   DateTime?
  followUpNote String?

  // Soft delete / anonymize (GDPR) — permanently scrubs personal fields
  isAnonymized Boolean   @default(false)
  deletedAt    DateTime?

  // Archive: hidden from default views but fully reversible, unlike anonymize.
  archivedAt DateTime?

  // Linked-record feature: a candidate and a client-contact record can represent
  // the same human being over time. This self-relation lets us flip which side
  // is "primary" without losing history on either record.
  // @unique enforces "at most one link at a time" on the target side — a
  // given person can only ever be pointed at by one other record. The
  // owning side is naturally capped at one link since linkedPersonId is a
  // single scalar field, not a list.
  linkedPersonId String?  @unique
  linkedPerson   Person?  @relation("PersonLink", fields: [linkedPersonId], references: [id])
  linkedFrom     Person[] @relation("PersonLink")
  isPrimaryLink  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills            PersonSkill[]
  roleTypes         RoleType[]    @relation("PersonRoleTypes")
  documents         Document[]
  interactions      Interaction[]
  jobApplications   JobCandidate[]
  ownedJobs         Job[]         @relation("JobOwningContact")
  placements        Placement[]   @relation("PlacementCandidate")
  tags              TagLink[]

  @@map("people")
  @@index([personType])
  @@index([companyId])
  @@index([currentEmployerId])
}

// A hierarchical tag tree (any depth), shared by Person and Job skill
// assignment — not a fixed set of hardcoded categories. Grows as skills are
// added via the picker; parentId is null for a top-level branch.
//
// Uniqueness is scoped to (parentId, name), not name alone — the same leaf
// name can legitimately appear under two different branches (e.g. "Finance"
// under both D365 F&O and Business Central), and each is a distinct node.
model Skill {
  id       String  @id @default(uuid())
  name     String
  parentId String?
  parent   Skill?  @relation("SkillHierarchy", fields: [parentId], references: [id])
  children Skill[] @relation("SkillHierarchy")

  people PersonSkill[]
  jobsEssential Job[] @relation("JobEssentialSkills")
  jobsIdeal     Job[] @relation("JobIdealSkills")

  @@unique([parentId, name], name: "parentId_name")
  @@map("skills")
  @@index([parentId])
}

// Flat (non-hierarchical) tag list of professional role types — e.g.
// "Functional Consultant", "Solution Architect" — distinct from the Skill
// tree. A Candidate can hold several at once; a Job lists whichever the
// role requires. Grows via the same "add new on the fly" idiom as Skill.
model RoleType {
  id   String @id @default(uuid())
  name String @unique

  people Person[] @relation("PersonRoleTypes")
  jobs   Job[]    @relation("JobRoleTypes")

  @@map("role_types")
}

model PersonSkill {
  id       String @id @default(uuid())
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  skillId  String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // A candidate's real specialisms vs. everything else they're merely
  // competent in — a flag on the assignment itself, not a separate list.
  isPrimary Boolean @default(false)

  @@unique([personId, skillId])
  @@map("person_skills")
}

// ─────────────────────────────────────────────────────────────
// Jobs & Pipeline
// ─────────────────────────────────────────────────────────────

enum JobStage {
  POTENTIAL_LEAD
  QUALIFIED
  SPEC_TAKEN
  CV_SOURCING
  CVS_SENT
  INTERVIEWING
  OFFERED
  PLACED
  REJECTED
}

model Job {
  id       String @id @default(uuid())
  title    String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  level          String?
  location       String?
  workPreference WorkPreference?

  salaryMin Decimal? @db.Decimal(10, 2)
  salaryMax Decimal? @db.Decimal(10, 2)
  rateMin   Decimal? @db.Decimal(10, 2)
  rateMax   Decimal? @db.Decimal(10, 2)

  stage JobStage @default(POTENTIAL_LEAD)

  // Archive (soft-delete): hidden from default views but never hard-deleted —
  // jobs anchor pipeline/placement/interaction history.
  archivedAt DateTime?

  owningContactId String?
  owningContact   Person? @relation("JobOwningContact", fields: [owningContactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  essentialSkills Skill[]   @relation("JobEssentialSkills")
  idealSkills     Skill[]   @relation("JobIdealSkills")
  roleTypes       RoleType[] @relation("JobRoleTypes")

  candidates   JobCandidate[]
  documents    Document[]
  interactions Interaction[]
  stageChanges StageChange[]
  placement    Placement?
  tags         TagLink[]

  @@map("jobs")
  @@index([companyId])
  @@index([stage])
}

enum CandidateStage {
  SOURCED
  CV_SENT
  REJECTED
  INTERVIEWING
  OFFERED
  PLACED
}

model JobCandidate {
  id          String         @id @default(uuid())
  jobId       String
  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Person         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage       CandidateStage @default(SOURCED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageChanges StageChange[]

  @@unique([jobId, candidateId])
  @@map("job_candidates")
  @@index([stage])
}

// Append-only log of every stage transition, at job level or job-candidate level.
model StageChange {
  id             String   @id @default(uuid())
  jobId          String?
  job            Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobCandidateId String?
  jobCandidate   JobCandidate? @relation(fields: [jobCandidateId], references: [id], onDelete: Cascade)

  fromStage String?
  toStage   String
  changedById String?
  changedBy   User?  @relation(fields: [changedById], references: [id])
  note        String?

  createdAt DateTime @default(now())

  @@map("stage_changes")
  @@index([jobId])
  @@index([jobCandidateId])
}

// ─────────────────────────────────────────────────────────────
// Documents (versioned)
// ─────────────────────────────────────────────────────────────

enum DocumentType {
  CANDIDATE_CV
  CRUX_FORMATTED_CV
  TERMS_OF_BUSINESS
  COMPANY_DOC
  JOB_SPEC
  CONTRACTOR_CORP_DOC
  OTHER
}

model Document {
  id   String       @id @default(uuid())
  type DocumentType

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Compliance/expiry tracking (e.g. contractor insurance)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  versions DocumentVersion[]

  @@map("documents")
  @@index([personId])
  @@index([companyId])
  @@index([jobId])
}

// Every re-upload creates a new immutable version; nothing is overwritten.
model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNo   Int
  fileName    String
  storageKey  String
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime @default(now())
  note        String?

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

// ─────────────────────────────────────────────────────────────
// Interactions (append-only)
// ─────────────────────────────────────────────────────────────

enum InteractionType {
  PHONE_CALL
  VIDEO_MEETING
  FACE_TO_FACE
  QUALIFICATION_CALL
  LINKEDIN_MESSAGE
  EMAIL
  TEXT
}

model Interaction {
  id     String           @id @default(uuid())
  type   InteractionType
  notes  String?
  occurredAt DateTime     @default(now())

  personId String
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  jobId    String?
  job      Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Optional Teams call transcript, pasted or uploaded alongside the note —
  // when present, a call reflection is based on what was actually said, not
  // just what got written down.
  transcript String? @db.Text

  intelligence InteractionIntelligence?
  reflection   CallReflection?

  @@map("interactions")
  @@index([personId])
  @@index([jobId])
  @@index([companyId])
}

// AI-extracted intelligence from an interaction's notes — a derived artifact,
// not part of the append-only human-authored history, so re-running Extract
// Intelligence upserts (replaces) this rather than adding another row.
model InteractionIntelligence {
  id            String      @id @default(uuid())
  interactionId String      @unique
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  peopleMentioned    Json
  companiesMentioned Json
  marketSignals      Json
  followUpActions    Json
  notableQuotes      Json

  model     String
  createdAt DateTime @default(now())

  @@map("interaction_intelligence")
}

enum ReflectionBasis {
  TRANSCRIPT
  NOTE_ONLY
}

enum FeedbackReaction {
  UP
  DOWN
}

// A private, constructive critique of a Qualification Call — never a score.
// One per interaction (re-running replaces it, same derived-artifact idiom
// as InteractionIntelligence); `content` holds the structured reflection
// (thin sections, cross-section signals, the five core commercial
// questions, and a short closing summary).
model CallReflection {
  id            String      @id @default(uuid())
  interactionId String      @unique
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  basis   ReflectionBasis
  content Json
  model   String

  createdAt DateTime @default(now())

  feedback CallReflectionFeedback?

  @@map("call_reflections")
}

// The user's reaction to one reflection — the raw signal a rolling personal
// profile gets summarised from.
model CallReflectionFeedback {
  id           String         @id @default(uuid())
  reflectionId String         @unique
  reflection   CallReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)

  reaction FeedbackReaction
  comment  String?

  createdAt DateTime @default(now())

  @@map("call_reflection_feedback")
}

// A single rolling summary per user of the patterns in their call-review
// feedback — what tends to get missed, what's already done well, and what
// kinds of feedback they've dismissed as not useful. Regenerated (not
// appended) each time enough new feedback has accumulated, and fed as
// context into every future reflection so suggestions get more tailored
// over time instead of repeating the same generic notes.
model UserCallProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  summary String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_call_profiles")
}

// ─────────────────────────────────────────────────────────────
// Placements & Fees
// ─────────────────────────────────────────────────────────────

enum FeeType {
  PERM_PERCENTAGE
  CONTRACT_MARGIN
  DAY_RATE_UPLIFT
}

enum InvoiceStatus {
  NOT_INVOICED
  INVOICED
  PAID
  OVERDUE
  CANCELLED
}

model Placement {
  id          String   @id @default(uuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  candidateId String
  candidate   Person   @relation("PlacementCandidate", fields: [candidateId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  feeType     FeeType
  feeValue    Decimal  @db.Decimal(12, 2)
  invoiceStatus InvoiceStatus @default(NOT_INVOICED)
  invoiceRaisedDate DateTime?
  invoiceDueDate    DateTime?
  paidDate          DateTime?

  startDate DateTime
  endDate   DateTime?
  renewalReviewAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("placements")
}

// ─────────────────────────────────────────────────────────────
// Polymorphic tags / custom fields (extensibility without migrations)
// ─────────────────────────────────────────────────────────────

enum TaggableType {
  PERSON
  COMPANY
  JOB
  DOCUMENT
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  color String?

  links TagLink[]

  @@map("tags")
}

model TagLink {
  id            String       @id @default(uuid())
  tagId         String
  tag           Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  taggableType  TaggableType
  taggableId    String

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tagId, taggableType, taggableId])
  @@map("tag_links")
  @@index([taggableType, taggableId])
}

// Polymorphic custom fields: add new attributes to any entity without a migration.
model CustomField {
  id           String       @id @default(uuid())
  taggableType TaggableType
  taggableId   String
  key          String
  value        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taggableType, taggableId, key])
  @@map("custom_fields")
  @@index([taggableType, taggableId])
}
