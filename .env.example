# Postgres
POSTGRES_USER=crux
POSTGRES_PASSWORD=cruxpassword
POSTGRES_DB=crux_crm
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://crux:cruxpassword@localhost:5432/crux_crm
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
CORS_ORIGIN=http://localhost:5173
BACKEND_PORT=4000

# AI features (Extract Intelligence, call reflections) — a separate API key
# from console.anthropic.com, not your Claude.ai subscription. Leave blank to
# disable those features; everything else works fine without it.
ANTHROPIC_API_KEY=

# Frontend
VITE_API_URL=http://localhost:4000
FRONTEND_PORT=5173

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
